# Optional: Override Codex / ChatGPT Standalone Search Access Token
# If unset, pi-gpt-search automatically loads credentials from ~/.codex/auth.json
# CODEX_ACCESS_TOKEN=your_chatgpt_access_token_here
# CODEX_ACCOUNT_ID=your_chatgpt_account_id_here

# Optional: Enable verbose web search debugging
# PI_WEB_SEARCH_DEBUG=1
