{
  "name": "pi-gpt-search",
  "version": "1.0.1",
  "description": "Model-independent standalone web search extension for Pi coding agent powered by OpenAI Codex standalone search engine (Zero-GPT inference)",
  "main": "src/index.ts",
  "type": "module",
  "files": [
    "src/**/*",
    "README.md",
    "HOW-IT-WORKS.md",
    "HOW-IT-WAS-EXTRACT.md"
  ],
  "scripts": {
    "test": "NODE_PATH=/opt/homebrew/lib/node_modules/@earendil-works/pi-coding-agent/node_modules npx tsx --test tests/*.test.ts"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "web-search",
    "codex",
    "openai",
    "gemini",
    "claude",
    "agent"
  ],
  "author": "Mateus DCC",
  "license": "MIT",
  "dependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
